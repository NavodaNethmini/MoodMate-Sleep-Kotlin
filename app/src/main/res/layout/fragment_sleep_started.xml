<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moodmate_sleep_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvMoon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="☾"
        android:textColor="@color/moodmate_text_light"
        android:textSize="76sp"
        app:layout_constraintBottom_toTopOf="@id/tvSleepStartedTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSleepStartedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Sleep Started"
        android:textColor="@color/moodmate_text_light"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvSleepStartTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMoon" />

    <TextView
        android:id="@+id/tvSleepStartTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="10:42 PM"
        android:textColor="@color/moodmate_teal"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvSleepMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSleepStartedTitle" />

    <TextView
        android:id="@+id/tvSleepMessage"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Your sleep session is being recorded. Rest well and tap the button when you wake up."
        android:textColor="@color/moodmate_lavender"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btnImAwake"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSleepStartTime" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImAwake"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="46dp"
        android:text="I'm Awake"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/moodmate_teal"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSleepMessage" />

</androidx.constraintlayout.widget.ConstraintLayout>