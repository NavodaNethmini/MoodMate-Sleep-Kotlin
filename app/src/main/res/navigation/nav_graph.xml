<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.moodmatesleep.ui.splash.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splashFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.moodmatesleep.ui.welcome.WelcomeFragment"
        android:label="Welcome">

        <action
            android:id="@+id/action_welcomeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.moodmatesleep.ui.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_readyForBedFragment"
            app:destination="@id/readyForBedFragment" />

    </fragment>
    <fragment
        android:id="@+id/readyForBedFragment"
        android:name="com.example.moodmatesleep.ui.sleep.ReadyForBedFragment"
        android:label="Ready for Bed">

        <action
            android:id="@+id/action_readyForBedFragment_to_sleepStartedFragment"
            app:destination="@id/sleepStartedFragment"
            app:popUpTo="@id/readyForBedFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/sleepStartedFragment"
        android:name="com.example.moodmatesleep.ui.sleep.SleepStartedFragment"
        android:label="Sleep Started">

        <action
            android:id="@+id/action_sleepStartedFragment_to_sleepCheckInFragment"
            app:destination="@id/sleepCheckInFragment"
            app:popUpTo="@id/sleepStartedFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/sleepCheckInFragment"
        android:name="com.example.moodmatesleep.ui.sleep.SleepCheckInFragment"
        android:label="Check-In">

        <action
            android:id="@+id/action_sleepCheckInFragment_to_morningCheckInFragment"
            app:destination="@id/morningCheckInFragment" />

    </fragment>
    <fragment
        android:id="@+id/morningCheckInFragment"
        android:name="com.example.moodmatesleep.ui.morning.MorningCheckInFragment"
        android:label="Morning Check-In">

        <action
            android:id="@+id/action_morningCheckInFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/habitsFragment"
        android:name="com.example.moodmatesleep.ui.habits.HabitsFragment"
        android:label="Habits" />

    <fragment
        android:id="@+id/soundsFragment"
        android:name="com.example.moodmatesleep.ui.sounds.SoundsFragment"
        android:label="Sounds" />

    <fragment
        android:id="@+id/insightsFragment"
        android:name="com.example.moodmatesleep.ui.insights.InsightsFragment"
        android:label="Insights" />

</navigation>